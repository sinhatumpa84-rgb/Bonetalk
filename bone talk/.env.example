# ==============================================================================
# BONETALK ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development.
# IMPORTANT:
# - RAZORPAY_KEY_SECRET is strictly a BACKEND secret.
# - NEVER prefix RAZORPAY_KEY_SECRET with VITE_ (doing so exposes it to client JS).
# - NEVER commit your .env file to version control.
# ==============================================================================

# Razorpay Payment Gateway (TEST MODE)
# Replace with your Razorpay Test Key ID and Secret from Razorpay Dashboard
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Optional: Public Key ID for Frontend (Safe for client bundle)
# VITE_RAZORPAY_KEY_ID=

# Application Meta
VITE_APP_TITLE=BoneTalk
VITE_APP_ENV=development

# ==============================================================================
# REAL-TIME MQTT OVER WEBSOCKET CONFIGURATION
# ==============================================================================
# Use WSS in production, WS in local development.
# Example: wss://broker.emqx.io:8084/mqtt or ws://localhost:9001
VITE_MQTT_URL=wss://broker.emqx.io:8084/mqtt
VITE_MQTT_PORT=8084
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=
VITE_MQTT_CLIENT_ID=
VITE_MQTT_TOPIC=bonetalk/device/#
VITE_MQTT_QOS=0
VITE_DEVICE_ID=BONE-01

# ==============================================================================
# BACKEND WEBSOCKET STREAMING CONFIGURATION
# ==============================================================================
# Real-time WebSocket connection to FastAPI backend or streaming bridge
VITE_WS_URL=ws://localhost:8000/ws/emg
