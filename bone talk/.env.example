# ==============================================================================
# BONETALK ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development.
# IMPORTANT:
# - RAZORPAY_KEY_SECRET is strictly a BACKEND secret.
# - NEVER prefix RAZORPAY_KEY_SECRET with VITE_ (doing so exposes it to client JS).
# - NEVER commit your .env file to version control.
# ==============================================================================

# Razorpay Payment Gateway (TEST MODE)
# Replace with your Razorpay Test Key ID and Secret from Razorpay Dashboard
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Backend Server Configuration
PORT=5000
NODE_ENV=development

# Optional: Public Key ID for Frontend (Safe for client bundle)
# VITE_RAZORPAY_KEY_ID=

# Application Meta
VITE_APP_TITLE=BoneTalk
VITE_APP_ENV=development
